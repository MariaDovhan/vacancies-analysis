{
  "name": "vacancies-analysis",
  "version": "1.0.0",
  "private": true,
  "description": "Vacancies Analysis Monorepo",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "prepare": "husky",
    "build": "npm run build -w @vacancies-analysis/shared && npm run build -w @vacancies-analysis/backend && npm run build -w @vacancies-analysis/frontend",
    "build:shared": "npm run build -w @vacancies-analysis/shared",
    "build:backend": "npm run build -w @vacancies-analysis/backend",
    "build:frontend": "npm run build -w @vacancies-analysis/frontend",
    "lint": "npm run lint --workspaces",
    "lint:fix": "npm run lint --workspaces -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "test": "npm run test --workspaces",
    "check": "npm run format:check && npm run lint && npm run test && npm run build",
    "start:backend": "npm run start:dev -w @vacancies-analysis/backend",
    "start:frontend": "npm run dev -w @vacancies-analysis/frontend"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0"
  }
}

{
  "name": "vacancies-analysis",
  "version": "1.0.0",
  "private": true,
  "description": "Vacancies Analysis Monorepo",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "prepare": "husky",
    "build": "npm run build --workspaces",
    "build:backend": "npm run build -w @vacancies-analysis/backend",
    "build:frontend": "npm run build -w @vacancies-analysis/frontend",
    "lint": "npm run lint --workspaces",
    "lint:fix": "npm run lint --workspaces -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json}\"",
    "test": "npm run test --workspaces",
    "check": "npm run format:check && npm run lint && npm run test && npm run build",
    "start:backend": "npm run start:dev -w @vacancies-analysis/backend",
    "start:frontend": "npm run dev -w @vacancies-analysis/frontend"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.json": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.8"
  }
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Vacancy {
  id          String   @id @default(uuid())
  source      String
  externalId  String
  title       String
  company     String?
  description String
  url         String
  skills      String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([source, externalId])
}


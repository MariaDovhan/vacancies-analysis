C4Container
title C4 Model — Level 2: Container Diagram (Vacancies Analysis System)

Person(user, "User", "Browses vacancy listings and market analytics.")

Container_Boundary(system, "Vacancies Analysis System") {
  Container(frontend, "Frontend", "React, Vite, TypeScript", "Single-Page Application displaying listings and analytics.")
  Container(backend, "Backend (Modular Monolith)", "Node.js, NestJS, TypeScript", "Modules: market, analytics, ingestion, scheduled-jobs, prisma.")
  ContainerDb(db, "Database", "PostgreSQL", "Stores vacancy data.")
}

System_Ext(djinni, "Djinni RSS Feed", "https://djinni.co/jobs/rss/")
System_Ext(jobico, "Jobico XML Feed", "https://jobico.io/api/feeds/jobs.xml")

Rel(user, frontend, "Uses UI", "HTTPS")
Rel(frontend, backend, "Makes API calls", "HTTP / JSON")
Rel(backend, db, "Reads/writes", "Prisma / SQL")
Rel(backend, djinni, "Fetches job feed", "HTTPS / RSS XML")
Rel(backend, jobico, "Fetches job feed", "HTTPS / XML")
